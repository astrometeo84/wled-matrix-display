# Vorlage für scripts/ha_deploy.py. Kopieren nach .ha.env und ausfüllen.
# .ha.env steht in .gitignore, der Token landet also nicht im Repo.

# Samba-Freigabe (Windows / macOS) ...
HA_BLUEPRINT_ZIEL=\\homeassistant.local\config\blueprints\automation\wled_matrix
# ... oder scp über das SSH-Add-on:
# HA_BLUEPRINT_ZIEL=root@homeassistant.local:/config/blueprints/automation/wled_matrix/

# Optional: danach Konfiguration prüfen und Automationen neu laden
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
